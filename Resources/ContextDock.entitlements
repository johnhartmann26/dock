<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Switching Dia's profile with the context is an Apple Event; the hardened runtime blocks
       those (without even asking) unless the app declares it sends them. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
